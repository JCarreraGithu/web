{% extends 'dashboard/layout.html.twig' %}
{% block title %}Nuevo Logro{% endblock %}

{% block dashboard_content %}
<div class="container-fluid py-4">

  <div class="card border-0 shadow-lg rounded-4">
    <!-- Encabezado -->
    <div class="card-header bg-gradient text-white rounded-top-4 p-3"
         style="background: linear-gradient(135deg, #198754, #157347);">
      <h3 class="mb-0 fw-bold">
        <i class="bi bi-trophy-fill me-2"></i> Registrar Logro o Llamada de Atención
      </h3>
    </div>

    <!-- Cuerpo del formulario -->
    <div class="card-body bg-light p-5">
      {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

      <div class="row g-4">
        <div class="col-md-6">
          <label class="form-label fw-semibold text-secondary">
            <i class="bi bi-person-fill me-2 text-primary"></i> Empleado
          </label>
          {{ form_widget(form.empleado, {'attr': {'class': 'form-select shadow-sm'}}) }}
          {{ form_errors(form.empleado) }}
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold text-secondary">
            <i class="bi bi-calendar-event-fill me-2 text-primary"></i> Fecha de Ocurrencia
          </label>
          {{ form_widget(form.fecha_ocurrencia, {'attr': {'class': 'form-control shadow-sm'}}) }}
          {{ form_errors(form.fecha_ocurrencia) }}
        </div>

        <div class="col-12">
          <label class="form-label fw-semibold text-secondary">
            <i class="bi bi-chat-left-text-fill me-2 text-primary"></i> Descripción
          </label>
          {{ form_widget(form.description, {'attr': {'class': 'form-control shadow-sm', 'rows': '3', 'placeholder': 'Describa brevemente el logro o la llamada de atención...'}}) }}
          {{ form_errors(form.description) }}
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold text-secondary">
            <i class="bi bi-flag-fill me-2 text-primary"></i> Tipo de Registro
          </label>
          {{ form_widget(form.tipo, {'attr': {'class': 'form-select shadow-sm'}}) }}
          {{ form_errors(form.tipo) }}
        </div>
      </div>

      <div class="d-flex justify-content-end mt-5 gap-3">
        <a href="{{ path('logros_lista') }}" class="btn btn-secondary px-4 py-2 rounded-3 shadow-sm">
          <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <button type="submit" class="btn btn-success px-4 py-2 rounded-3 shadow-sm">
          <i class="bi bi-check-circle-fill me-1"></i> Guardar
        </button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
