{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión | Control de Empleados{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
    body {
        background: linear-gradient(135deg, #0d6efd 40%, #4a90e2);
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .login-container {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        padding: 40px 35px;
        width: 100%;
        max-width: 420px;
        animation: fadeIn 0.6s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .login-title {
        font-weight: 700;
        color: #0d6efd;
        text-align: center;
        margin-bottom: 25px;
    }

    .login-icon {
        display: block;
        margin: 0 auto 15px;
        color: #0d6efd;
        font-size: 3rem;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,.25);
    }

    .btn-login {
        background-color: #0d6efd;
        border: none;
        transition: 0.3s;
        font-weight: 500;
    }

    .btn-login:hover {
        background-color: #0b5ed7;
        transform: scale(1.02);
    }

    .alert-danger {
        font-size: 0.9rem;
        border-radius: 8px;
        text-align: center;
    }

    footer {
        position: fixed;
        bottom: 10px;
        text-align: center;
        width: 100%;
        color: #fff;
        font-size: 0.9rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="login-container">
    <i class="bi bi-person-circle login-icon"></i>
    <h2 class="login-title">Control de Empleados</h2>

    {% if error %}
        <div class="alert alert-danger py-2">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="mb-3">
            <label for="username" class="form-label fw-semibold">Usuario</label>
            <input type="text" id="username" name="username" value="{{ last_username }}" required autofocus class="form-control" placeholder="Ingresa tu usuario">
        </div>

        <div class="mb-4">
            <label for="password" class="form-label fw-semibold">Contraseña</label>
            <input type="password" id="password" name="password" required class="form-control" placeholder="••••••••">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn btn-login w-100 py-2 text-white">
            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar sesión
        </button>
    </form>
</div>

<footer>
    © {{ "now"|date("Y") }} Sistema de Control de Empleados — Empresa XYZ
</footer>
{% endblock %}
