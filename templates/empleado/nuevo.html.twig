{% extends 'dashboard/layout.html.twig' %}
{% block title %}➕ Nuevo Empleado{% endblock %}

{% block dashboard_content %}
<h3 class="mb-3">Registrar nuevo empleado</h3>

{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
  <div class="row g-3">
    <div class="col-md-6">{{ form_row(form.nombre) }}</div>
    <div class="col-md-6">{{ form_row(form.apellido) }}</div>
    <div class="col-md-6">{{ form_row(form.fecha_nacimiento) }}</div>
    <div class="col-md-6">{{ form_row(form.salario) }}</div>
    <div class="col-md-6">{{ form_row(form.puesto) }}</div>
    <div class="col-md-6">{{ form_row(form.tienda) }}</div>
    <div class="col-12">{{ form_row(form.fotografia) }}</div>
  </div>
  <div class="mt-3">
    <a href="{{ path('empleados_lista') }}" class="btn btn-secondary">Cancelar</a>
    <button class="btn btn-primary" type="submit">Guardar</button>
  </div>
{{ form_end(form) }}
{% endblock %}
