{% extends 'dashboard/layout.html.twig' %}

{% block title %}Lista de Empleados{% endblock %}

{% block dashboard_content %}
<style>
  /* === Estilo de fondo y tema tecnológico === */
  body {
    background: radial-gradient(circle at top left, #0a0f1e, #111827);
    color: #e2e8f0;
  }

  .card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .table {
    color: #f8fafc;
  }

  .table thead {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
  }

  .btn-primary {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    border: none;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #1e40af, #6d28d9);
  }

  .badge.bg-info {
    background: linear-gradient(135deg, #38bdf8, #0ea5e9);
    color: #0f172a;
  }

  .alert-success {
    background: rgba(34, 197, 94, 0.15);
    color: #bbf7d0;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.05);
    transition: 0.2s ease-in-out;
  }

  h2, h3, h4, h5 {
    color: #93c5fd;
  }
</style>

<div class="container-fluid px-4 py-3">

  <!-- Encabezado -->
  <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
    <h2 class="fw-bold mb-0">
      <i class="bi bi-people-fill me-2 text-info"></i> Lista de Empleados
    </h2>
    <a href="{{ path('empleado_nuevo') }}" class="btn btn-primary shadow-sm px-4">
      <i class="bi bi-person-plus-fill me-1"></i> Agregar Empleado
    </a>
  </div>

  <!-- Mensajes de éxito -->
  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <!-- Tabla -->
  <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0 text-center">
        <thead>
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Puesto</th>
            <th>Tienda</th>
            <th>Salario</th>
            <th>Fecha Nacimiento</th>
          </tr>
        </thead>
        <tbody>
          {% for e in empleados %}
            <tr>
              <td class="fw-semibold text-secondary">{{ e.id }}</td>
              <td>{{ e.nombre }}</td>
              <td>{{ e.apellido }}</td>
              <td><span class="badge bg-info text-dark shadow-sm">{{ e.puesto.nombre }}</span></td>
              <td>{{ e.tienda.nombre }}</td>
              <td class="fw-bold text-success">Q{{ e.salario|number_format(2, '.', ',') }}</td>
              <td>{{ e.fechaNacimiento|date('d/m/Y') }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-muted py-4">No hay empleados registrados.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}