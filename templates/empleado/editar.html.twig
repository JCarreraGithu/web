{% extends 'dashboard/layout.html.twig' %}
{% block title %}✏️ Editar Empleado{% endblock %}

{% block dashboard_content %}
<style>
  body {
    background-color: #f8f9fa;
    color: #212529;
  }
  .card {
    background-color: #fff;
    border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .card-header {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
  }
  label {
    color: #212529;
    font-weight: 600;
  }
  .form-control, .form-select {
    background-color: #fff;
    color: #212529;
    border: 1px solid #ced4da;
  }
  .form-control:focus, .form-select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 5px rgba(37,99,235,0.3);
  }
  .btn-primary {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    border: none;
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #1d4ed8, #6d28d9);
  }
  .btn-secondary {
    background-color: #6c757d;
    color: #fff;
    border: none;
  }
  .btn-secondary:hover {
    background-color: #5c636a;
  }
</style>

<div class="container py-4">
  <div class="card rounded-4">
    <div class="card-header p-3 d-flex justify-content-between align-items-center">
      <h4 class="mb-0 fw-bold">
        <i class="bi bi-pencil-square me-2"></i> Editar Empleado
      </h4>
      <a href="{{ path('empleados_lista') }}" class="btn btn-light btn-sm">
        <i class="bi bi-arrow-left-circle me-1"></i> Volver
      </a>
    </div>

    <div class="card-body p-4">
      {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
      <div class="row">
        <div class="col-md-6 mb-3">{{ form_row(form.nombre) }}</div>
        <div class="col-md-6 mb-3">{{ form_row(form.apellido) }}</div>
        <div class="col-md-6 mb-3">{{ form_row(form.fecha_nacimiento) }}</div>
        <div class="col-md-6 mb-3">{{ form_row(form.salario) }}</div>
        <div class="col-md-6 mb-3">{{ form_row(form.puesto) }}</div>
        <div class="col-md-6 mb-3">{{ form_row(form.tienda) }}</div>
        <div class="col-md-12 mb-3">
          {{ form_label(form.fotografia, 'Actualizar Fotografía') }}
          {{ form_widget(form.fotografia, {'attr': {'class': 'form-control'}}) }}
          {% if e.fotografia %}
            <div class="mt-3">
              <p class="text-muted mb-1">Fotografía actual:</p>
              <img src="{{ asset('uploads/' ~ e.fotografia) }}" class="rounded shadow-sm" style="width: 120px; height: 120px; object-fit: cover;">
            </div>
          {% endif %}
        </div>
      </div>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-primary px-4 me-2">
          <i class="bi bi-save me-1"></i> Guardar Cambios
        </button>
        <a href="{{ path('empleados_lista') }}" class="btn btn-secondary px-4">
          <i class="bi bi-x-circle me-1"></i> Cancelar
        </a>
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}