{% extends 'dashboard/layout.html.twig' %}
{% block title %}✏️ Editar Empleado{% endblock %}

{% block dashboard_content %}
<div class="container-fluid py-4">
  <div class="card border-0 shadow-lg rounded-4">
    <div class="card-header bg-gradient text-white rounded-top-4 p-3" 
         style="background: linear-gradient(135deg, #0d6efd, #6610f2);">
      <h3 class="mb-0 fw-bold">
        <i class="bi bi-pencil-square me-2"></i> Editar Empleado
      </h3>
    </div>

    <div class="card-body px-5 py-4 bg-light">
      {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
      <div class="row g-4">

        <div class="col-md-6">
          {{ form_label(form.nombre, 'Nombre', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.nombre, {'attr': {'class': 'form-control form-control-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-6">
          {{ form_label(form.apellido, 'Apellido', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.apellido, {'attr': {'class': 'form-control form-control-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-6">
          {{ form_label(form.fecha_nacimiento, 'Fecha de Nacimiento', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.fecha_nacimiento, {'attr': {'class': 'form-control form-control-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-6">
          {{ form_label(form.salario, 'Salario', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.salario, {'attr': {'class': 'form-control form-control-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-6">
          {{ form_label(form.puesto, 'Puesto', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.puesto, {'attr': {'class': 'form-select form-select-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-6">
          {{ form_label(form.tienda, 'Tienda', {'label_attr': {'class': 'fw-semibold text-secondary'}}) }}
          {{ form_widget(form.tienda, {'attr': {'class': 'form-select form-select-lg border-0 shadow-sm rounded-3'}}) }}
        </div>

        <div class="col-md-12">
          <label class="fw-semibold text-secondary d-block mb-2">Fotografía (deja en blanco si no deseas cambiarla)</label>
          {% if e.fotografia %}
            <div class="mb-2">
              <img src="{{ asset('uploads/' ~ e.fotografia) }}" class="rounded border" style="width:90px;height:90px;object-fit:cover;">
            </div>
          {% endif %}
          <div class="input-group shadow-sm rounded-3">
            <span class="input-group-text bg-white border-0">
              <i class="bi bi-image"></i>
            </span>
            {{ form_widget(form.fotografia, {'attr': {'class': 'form-control border-0'}}) }}
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end mt-5 gap-3">
        <a href="{{ path('empleados_lista') }}" class="btn btn-outline-secondary btn-lg px-4 rounded-3">
          Cancelar
        </a>
        <button type="submit" class="btn btn-primary btn-lg px-4 rounded-3 shadow-sm">
          Guardar cambios
        </button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
