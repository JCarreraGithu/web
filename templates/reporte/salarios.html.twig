{% extends 'dashboard/layout.html.twig' %}
{% block title %}Salarios por Tienda{% endblock %}

{% block dashboard_content %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fw-bold text-primary"><i class="bi bi-cash-stack me-2"></i> Salarios de Empleados por Tienda</h2>
    <div class="d-flex gap-2">
      <a href="{{ path('reporte_salarios_xlsx') }}" class="btn btn-outline-success btn-sm fw-semibold">
        <i class="bi bi-file-earmark-excel me-1"></i> XLSX
      </a>
      <a href="{{ path('reporte_salarios_pdf') }}" class="btn btn-outline-danger btn-sm fw-semibold">
        <i class="bi bi-file-earmark-pdf me-1"></i> PDF
      </a>
    </div>
  </div>

  {% for tienda, empleados in agrupados %}
    <div class="card mb-4 shadow-sm border-0 rounded-4">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">{{ tienda }}</h5>
        <span class="badge bg-light text-dark">{{ empleados|length }} Empleado{{ empleados|length > 1 ? 's' : '' }}</span>
      </div>
      <div class="card-body bg-white">
        <table class="table table-striped table-bordered text-center align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>Puesto</th>
              <th>Salario (Q)</th>
            </tr>
          </thead>
          <tbody>
            {% for e in empleados %}
              <tr>
                <td>{{ e.nombre }}</td>
                <td>{{ e.apellido }}</td>
                <td>{{ e.puesto.nombre }}</td>
                <td>Q{{ e.salario|number_format(2, '.', ',') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <p class="text-center text-muted mt-5">No hay empleados registrados.</p>
  {% endfor %}
</div>
{% endblock %}
