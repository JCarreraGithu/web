{% extends 'dashboard/layout.html.twig' %}
{% block title %}Salarios por Tienda{% endblock %}

{% block dashboard_content %}
<div class="container mt-4">
  <h2 class="mb-4 text-center">💼 Salarios de Empleados por Tienda</h2>

  {% for tienda, empleados in agrupados %}
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0">{{ tienda }}</h5>
      </div>
      <div class="card-body">
        <table class="table table-striped table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>Puesto</th>
              <th>Salario (Q)</th>
            </tr>
          </thead>
          <tbody>
            {% for e in empleados %}
              <tr>
                <td>{{ e.nombre }}</td>
                <td>{{ e.apellido }}</td>
                <td>{{ e.puesto.nombre }}</td>
                <td>Q{{ e.salario|number_format(2, '.', ',') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <p class="text-center text-muted">No hay empleados registrados.</p>
  {% endfor %}
</div>
{% endblock %}
