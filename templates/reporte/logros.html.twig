{% extends 'dashboard/layout.html.twig' %}
{% block title %}Reporte de Logros{% endblock %}

{% block dashboard_content %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fw-bold text-primary">
      <i class="bi bi-trophy-fill me-2"></i> Reporte de Logros por Empleado
    </h2>
    <a href="{{ path('reporte_logros_pdf') }}" class="btn btn-outline-danger btn-sm fw-semibold">
      <i class="bi bi-file-earmark-pdf me-1"></i> PDF
    </a>
  </div>

  {% for empleado, logros in agrupados %}
    <div class="card mb-3 shadow-sm border-0 rounded-4">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">{{ empleado }}</h5>
        <span class="badge bg-light text-dark">{{ logros|length }} Registro{{ logros|length > 1 ? 's' : '' }}</span>
      </div>
      <div class="card-body bg-white">
        <table class="table table-striped text-center align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Descripción</th>
              <th>Tipo</th>
              <th>Fecha</th>
            </tr>
          </thead>
          <tbody>
            {% for l in logros %}
              <tr>
                <td class="text-start">{{ l.description }}</td>
                <td>
                  {% if l.tipo|lower starts with 'pos' %}
                    <span class="badge bg-success">Positivo</span>
                  {% else %}
                    <span class="badge bg-danger">Negativo</span>
                  {% endif %}
                </td>
                <td>{{ l.fechaOcurrencia|date('d/m/Y') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <p class="text-center text-muted mt-5">No hay logros registrados.</p>
  {% endfor %}
</div>
{% endblock %}
