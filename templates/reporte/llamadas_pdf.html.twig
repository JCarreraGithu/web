<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Reporte de Llamadas de Atención</title>
  <style>
    @page { margin: 18mm 14mm; }
    html, body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 12px; color:#111; }
    h1, h2 { margin:0 0 8px; }
    h1 { font-size:18px; } h2 { font-size:15px; }
    .muted{ color:#666; }

    .grupo { margin-bottom:14px; break-inside:avoid; page-break-inside:avoid; }
    .header-grupo{ background:#b91c1c; color:#fff; padding:8px 10px; border-radius:6px; }

    table{ width:100%; border-collapse:collapse; margin-top:8px; }
    thead{ background:#fee2e2; display: table-header-group; }
    tr{ page-break-inside:avoid; }
    th,td{ border:1px solid #f3c9c9; padding:6px 8px; text-align:center; }
    td.txt{ text-align:left; }
  </style>
</head>
<body>
  <h1>Reporte de Llamadas de Atención (Negativas)</h1>
  <p class="muted">Generado automáticamente</p>

  {% for empleado, logros in agrupados %}
    <section class="grupo">
      <div class="header-grupo">
        <h2>{{ empleado }}</h2>
      </div>

      <table>
        <thead>
          <tr>
            <th>Descripción</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          {% for l in logros %}
            <tr>
              <td class="txt">{{ l.description }}</td>
              <td>{{ l.fechaOcurrencia|date('d/m/Y') }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% else %}
    <p class="muted">No hay registros.</p>
  {% endfor %}
</body>
</html>
