{% extends 'dashboard/layout.html.twig' %}
{% block title %}Reporte de Llamadas de Atención{% endblock %}

{% block dashboard_content %}
<div class="container-fluid py-4">
  <div class="card shadow-lg border-0 rounded-4 mb-5">
    <div class="card-header bg-gradient text-white rounded-top-4 p-3"
         style="background: linear-gradient(135deg, #dc3545, #6c1b2a);">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fw-bold">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> Reporte de Llamadas de Atención
        </h3>
        <a href="{{ path('reporte_llamadas_pdf') }}" class="btn btn-light btn-sm fw-semibold shadow-sm">
          <i class="bi bi-file-earmark-pdf text-danger me-1"></i> Generar PDF
        </a>
      </div>
    </div>

    <div class="card-body bg-light px-5 py-4">
      {% if agrupados is not empty %}
        {% for empleado, logros in agrupados %}
          <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-person-fill me-2"></i> {{ empleado }}
              </h5>
              <span class="badge bg-light text-danger px-3 py-2">
                {{ logros|length }} Llamada{{ logros|length > 1 ? 's' : '' }}
              </span>
            </div>
            <div class="card-body bg-white">
              <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center mb-0">
                  <thead class="table-danger">
                    <tr><th>Descripción</th><th>Fecha</th></tr>
                  </thead>
                  <tbody>
                    {% for l in logros %}
                      <tr>
                        <td class="text-start">
                          <i class="bi bi-chat-left-dots me-2 text-danger"></i>{{ l.description }}
                        </td>
                        <td class="fw-semibold">{{ l.fechaOcurrencia|date('d/m/Y') }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-emoji-smile display-3 d-block mb-3"></i>
          <h5>No hay llamadas de atención registradas 🎉</h5>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
